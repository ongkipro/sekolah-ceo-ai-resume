---
import AppLayout from '../layouts/AppLayout.astro';
import RoadmapTracker from '../components/RoadmapTracker';
import { Target, ArrowLeft } from 'lucide-react';
---

<AppLayout title="30-60-90 Days Implementation Roadmap - Sekolah CEO AI">
  <!-- Page Header -->
  <div class="space-y-2 pb-6 border-b border-slate-200 dark:border-slate-800">
    <div class="flex items-center gap-2">
      <a href="/" class="text-xs font-semibold text-slate-400 hover:text-blue-600 flex items-center gap-1">
        <ArrowLeft className="w-3.5 h-3.5" /> Dashboard
      </a>
      <span class="text-slate-300 dark:text-slate-700">/</span>
      <span class="text-xs font-semibold text-rose-600 dark:text-rose-400">Modul 07</span>
    </div>
    <div class="flex items-center gap-2.5">
      <div class="w-10 h-10 rounded-xl bg-rose-100 dark:bg-rose-900/60 text-rose-600 dark:text-rose-400 flex items-center justify-center font-bold">
        <Target className="w-5 h-5" />
      </div>
      <div>
        <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          30-60-90 Days Implementation Roadmap Tracker
        </h1>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Panduan eksekusi bertahap untuk CEO & Founder. Progres checklist otomatis tersimpan di browser dan siap dicetak sebagai laporan eksekutif.
        </p>
      </div>
    </div>
  </div>

  <!-- Interactive Roadmap Island -->
  <RoadmapTracker client:load />
</AppLayout>
