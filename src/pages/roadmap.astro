---
import AppLayout from '../layouts/AppLayout.astro';
import RoadmapTracker from '../components/RoadmapTracker';
import { Target } from 'lucide-react';

const title = "30-60-90 Days Action Plan - Sekolah CEO AI (Agustus 2026)";
const description = "Panduan eksekusi bertahap C-Level pasca masterclass dengan checklist interaktif tersimpan di browser dan fitur ekspor PDF.";
---

<AppLayout title={title} description={description} breadcrumbs={[{ label: '30-60-90 Roadmap' }]}>
  <div class="space-y-6">
    <!-- Header Strip -->
    <div class="space-y-2 pb-4 border-b border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-2">
        <span class="p-1.5 rounded-lg bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400">
          <Target className="w-4 h-4" />
        </span>
        <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 font-mono">
          Executive Roadmap
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
        30-60-90 Days Implementation Roadmap
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
        Panduan langkah demi langkah implementasi AI di perusahaan Anda pasca-masterclass. Centang setiap tugas saat selesai, status akan tersimpan otomatis di perangkat Anda.
      </p>
    </div>

    <!-- Interactive Roadmap Tracker Island -->
    <RoadmapTracker client:load />
  </div>
</AppLayout>
