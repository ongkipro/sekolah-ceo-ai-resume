---
import AppLayout from '../layouts/AppLayout.astro';
import FrameworkDiagrams from '../components/FrameworkDiagrams';
import { Layers, ArrowLeft } from 'lucide-react';
---

<AppLayout title="Visual Architecture Blueprints - Sekolah CEO AI">
  <!-- Page Header -->
  <div class="space-y-2 pb-6 border-b border-slate-200 dark:border-slate-800">
    <div class="flex items-center gap-2">
      <a href="/" class="text-xs font-semibold text-slate-400 hover:text-blue-600 flex items-center gap-1">
        <ArrowLeft className="w-3.5 h-3.5" /> Dashboard
      </a>
      <span class="text-slate-300 dark:text-slate-700">/</span>
      <span class="text-xs font-semibold text-indigo-600 dark:text-indigo-400">Modul 03</span>
    </div>
    <div class="flex items-center gap-2.5">
      <div class="w-10 h-10 rounded-xl bg-indigo-100 dark:bg-indigo-900/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold">
        <Layers className="w-5 h-5" />
      </div>
      <div>
        <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          Visual Architecture Blueprints & Business Flows
        </h1>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Peta alur kerja operasional: Growth Funnel 0 CAC, Sistem Koran Perusahaan 07.00, Local Command Center (Option+Space), & Auto-PO Purchasing.
        </p>
      </div>
    </div>
  </div>

  <!-- Interactive Diagrams Island -->
  <FrameworkDiagrams client:load />
</AppLayout>
