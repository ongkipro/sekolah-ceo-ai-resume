---
import AppLayout from '../layouts/AppLayout.astro';
import ExecutiveDecisionSimulator from '../components/ExecutiveDecisionSimulator';
import { Calculator, ArrowLeft } from 'lucide-react';
---

<AppLayout title="CEO Decision & Headcount Allocator Simulator - Sekolah CEO AI">
  <!-- Page Header -->
  <div class="space-y-2 pb-6 border-b border-slate-200 dark:border-slate-800">
    <div class="flex items-center gap-2">
      <a href="/" class="text-xs font-semibold text-slate-400 hover:text-blue-600 flex items-center gap-1">
        <ArrowLeft className="w-3.5 h-3.5" /> Dashboard
      </a>
      <span class="text-slate-300 dark:text-slate-700">/</span>
      <span class="text-xs font-semibold text-blue-600 dark:text-blue-400">Modul 05</span>
    </div>
    <div class="flex items-center gap-2.5">
      <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/60 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold">
        <Calculator className="w-5 h-5" />
      </div>
      <div>
        <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          CEO Decision Simulator: Alokasi Tugas AI vs Manusia
        </h1>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Simulasikan bagaimana dekonstruksi job desk menjadi micro-tasks memangkas jam kerja repetitif dan menghemat biaya hingga 90%.
        </p>
      </div>
    </div>
  </div>

  <!-- Interactive Simulator Island -->
  <ExecutiveDecisionSimulator client:load />
</AppLayout>
