---
import AppLayout from '../layouts/AppLayout.astro';
import ToolsMatrix from '../components/ToolsMatrix';
import { Wrench, ArrowLeft } from 'lucide-react';
---

<AppLayout title="AI Tools Comparison Matrix & Directory - Sekolah CEO AI">
  <!-- Page Header -->
  <div class="space-y-2 pb-6 border-b border-slate-200 dark:border-slate-800">
    <div class="flex items-center gap-2">
      <a href="/" class="text-xs font-semibold text-slate-400 hover:text-blue-600 flex items-center gap-1">
        <ArrowLeft className="w-3.5 h-3.5" /> Dashboard
      </a>
      <span class="text-slate-300 dark:text-slate-700">/</span>
      <span class="text-xs font-semibold text-purple-600 dark:text-purple-400">Modul 06</span>
    </div>
    <div class="flex items-center gap-2.5">
      <div class="w-10 h-10 rounded-xl bg-purple-100 dark:bg-purple-900/60 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold">
        <Wrench className="w-5 h-5" />
      </div>
      <div>
        <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          AI Tools Comparison Matrix & Directory
        </h1>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Daftar software & platform AI rekomendasi para instruktur (Claude, Lovable, Kling, Suno, HeyGen, ManyChat, N8N, NotebookLM) beserta use case dan skor dampaknya.
        </p>
      </div>
    </div>
  </div>

  <!-- Interactive Tools Matrix Island -->
  <ToolsMatrix client:load />
</AppLayout>
