---
import AppLayout from '../../layouts/AppLayout.astro';
import SectionSubNav from '../../components/SectionSubNav.astro';
import SingleSimulatorView from '../../components/SingleSimulatorView';
import simulatorData from '../../data/simulator.json';
import { simulatorSlugs } from '../../lib/slugs';

export async function getStaticPaths() {
  return simulatorSlugs.map(({ slug, id }) => {
    const sim = simulatorData.find((s) => s.id === id);
    return {
      params: { slug },
      props: { sim, slug },
    };
  });
}

const { sim, slug } = Astro.props;
const title = `Simulasi AI: ${sim.roleName} - CEO Decision Simulator`;
const description = `Dekonstruksi tugas untuk ${sim.roleName} (${sim.department}).`;
const shortRoleName = sim.roleName.split('&')[0].trim();

const breadcrumbs = [
  { label: 'CEO Simulator', href: '/simulator' },
  { label: shortRoleName }
];

const subNavItems = simulatorSlugs.map(s => ({
  name: s.name.split('&')[0].trim(),
  href: `/simulator/${s.slug}`
}));
---

<AppLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <div class="space-y-6 max-w-full">
    <!-- Section Sub-Navigation -->
    <SectionSubNav
      currentPath={`/simulator/${slug}`}
      hubHref="/simulator"
      hubLabel="🧮 Semua Posisi"
      items={subNavItems}
    />
    <SingleSimulatorView client:load simulatorId={sim.id} />
  </div>
</AppLayout>
