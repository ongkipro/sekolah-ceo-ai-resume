---
import AppLayout from '../layouts/AppLayout.astro';
import LaymanGlossary from '../components/LaymanGlossary';
import { BookMarked, ArrowLeft } from 'lucide-react';
---

<AppLayout title="Kamus Istilah AI Bahasa Orang Awam - Sekolah CEO AI">
  <!-- Page Header -->
  <div class="space-y-2 pb-6 border-b border-slate-200 dark:border-slate-800">
    <div class="flex items-center gap-2">
      <a href="/" class="text-xs font-semibold text-slate-400 hover:text-blue-600 flex items-center gap-1">
        <ArrowLeft className="w-3.5 h-3.5" /> Dashboard
      </a>
      <span class="text-slate-300 dark:text-slate-700">/</span>
      <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400">Modul 02</span>
    </div>
    <div class="flex items-center gap-2.5">
      <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-900/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold">
        <BookMarked className="w-5 h-5" />
      </div>
      <div>
        <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          Kamus Istilah AI Bahasa Orang Awam
        </h1>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Glosarium istilah teknis AI (LLM, Halusinasi, Auto-PO, ManyChat, Token, B.R.I.E.F.) yang dijelaskan dengan analogi sederhana untuk pemilik bisnis.
        </p>
      </div>
    </div>
  </div>

  <!-- Interactive Glossary Island -->
  <LaymanGlossary client:load />
</AppLayout>
