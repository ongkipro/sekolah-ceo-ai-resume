---
import AppLayout from '../layouts/AppLayout.astro';
import LaymanGlossary from '../components/LaymanGlossary';
import { BookMarked } from 'lucide-react';

const title = "Kamus Istilah AI Bahasa Orang Awam - Sekolah CEO AI";
const description = "Glosarium istilah teknis AI (LLM, Halusinasi, Auto-PO, ManyChat, Token, B.R.I.E.F.) yang dijelaskan dengan analogi analog dunia nyata untuk pemilik bisnis.";
---

<AppLayout title={title} description={description} breadcrumbs={[{ label: 'Kamus Istilah Awam' }]}>
  <div class="space-y-6">
    <!-- Header Strip -->
    <div class="space-y-2 pb-4 border-b border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-2">
        <span class="p-1.5 rounded-lg bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400">
          <BookMarked className="w-4 h-4" />
        </span>
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-mono">
          Layman Glossary
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
        Kamus Istilah AI Bahasa Orang Awam
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
        Glosarium istilah teknis AI yang dijelaskan dengan analogi analog dunia nyata agar para pemilik bisnis dan eksekutif non-teknis langsung memahaminya tanpa kebingungan.
      </p>
    </div>

    <!-- Interactive Glossary Island -->
    <LaymanGlossary client:load />
  </div>
</AppLayout>
