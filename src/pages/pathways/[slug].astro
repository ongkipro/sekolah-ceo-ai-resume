---
import AppLayout from '../../layouts/AppLayout.astro';
import SectionSubNav from '../../components/SectionSubNav.astro';
import pathwaysData from '../../data/pathways.json';
import { pathwaySlugs } from '../../lib/slugs';
import { Compass, ArrowRight, Layers, ArrowLeft, CheckCircle2 } from 'lucide-react';

export async function getStaticPaths() {
  return pathwaySlugs.map(({ slug, role }) => {
    const pathway = pathwaysData.find((p) => p.role === role);
    return {
      params: { slug },
      props: { pathway, slug },
    };
  });
}

const { pathway, slug } = Astro.props;
const currentIndex = pathwaySlugs.findIndex((p) => p.slug === slug);
const prevPathway = currentIndex > 0 ? pathwaySlugs[currentIndex - 1] : null;
const nextPathway = currentIndex < pathwaySlugs.length - 1 ? pathwaySlugs[currentIndex + 1] : null;

const title = `${pathway.title} - Sekolah CEO AI`;
const description = pathway.description;

const breadcrumbs = [
  { label: 'Jalur Peran', href: '/pathways' },
  { label: pathway.role }
];

const subNavItems = pathwaySlugs.map(p => ({
  name: p.role.split('&')[0].trim(),
  href: `/pathways/${p.slug}`
}));
---

<AppLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <div class="space-y-6 max-w-full">
    <!-- Section Sub-Navigation -->
    <SectionSubNav
      currentPath={`/pathways/${slug}`}
      hubHref="/pathways"
      hubLabel="Semua Peran"
      items={subNavItems}
    />

    <!-- Role Header Card -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl sm:rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 pb-5 border-b border-slate-100 dark:border-slate-800">
        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <span class="text-3xl">{pathway.icon}</span>
            <span class="text-xs font-mono font-bold uppercase tracking-wider px-2.5 py-1 rounded-lg bg-indigo-50 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-900">
              {pathway.role}
            </span>
          </div>
          <h1 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white leading-snug">
            {pathway.title}
          </h1>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
            {pathway.description}
          </p>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 text-xs font-mono text-slate-500 dark:text-slate-400 shrink-0">
          <div>Status:</div>
          <div class="font-bold text-slate-900 dark:text-white">{pathway.keyFocus.length} Fokus Utama</div>
        </div>
      </div>

      <!-- Recommended Modules List -->
      <div class="space-y-4">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
          <Layers className="w-4 h-4 text-indigo-500" />
          <span>Langkah Modul yang Direkomendasikan untuk Anda:</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {pathway.keyFocus.map((focus: any, idx: number) => (
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/60 flex flex-col justify-between space-y-4 hover:border-indigo-500/60 transition-all group shadow-sm">
              <div class="space-y-2">
                <div class="flex items-center gap-2">
                  <span class="w-6 h-6 rounded-lg bg-indigo-100 dark:bg-indigo-900 text-indigo-700 dark:text-indigo-300 font-bold text-xs flex items-center justify-center shrink-0 font-mono">
                    0{idx + 1}
                  </span>
                  <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white leading-snug">
                    {focus}
                  </h3>
                </div>
                
              </div>

              <div class="pt-3 border-t border-slate-200/60 dark:border-slate-700/60 flex items-center justify-between text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">
                <div class="flex items-center gap-1.5">
                  <CheckCircle2 className="w-3.5 h-3.5 text-indigo-500" />
                  <span>Fokus Utama</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Navigation to Previous / Next Role -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-2">
      {prevPathway ? (
        <a
          href={`/pathways/${prevPathway.slug}`}
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors w-full sm:w-auto justify-center cursor-pointer"
        >
          <ArrowLeft className="w-4 h-4" />
          <span>Jalur Sebelumnya ({prevPathway.name})</span>
        </a>
      ) : <div />}

      {nextPathway ? (
        <a
          href={`/pathways/${nextPathway.slug}`}
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold transition-all shadow-sm w-full sm:w-auto justify-center cursor-pointer"
        >
          <span>Jalur Berikutnya ({nextPathway.name})</span>
          <ArrowRight className="w-4 h-4" />
        </a>
      ) : <div />}
    </div>
  </div>
</AppLayout>
