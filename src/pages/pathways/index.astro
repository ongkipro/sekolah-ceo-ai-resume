---
import AppLayout from '../../layouts/AppLayout.astro';
import SectionSubNav from '../../components/SectionSubNav.astro';
import pathwaysData from '../../data/pathways.json';
import { pathwaySlugs } from '../../lib/slugs';
import { Compass, ArrowRight, Layers, Sparkles } from 'lucide-react';

const title = "Jalur Belajar Berdasarkan Peran Kepemimpinan - Sekolah CEO AI";
const description = "Kurikulum terarah khusus CEO, CFO, CMO, dan COO untuk menerapkan AI sesuai tanggung jawab bisnis dan metrik finansial masing-masing.";

const subNavItems = pathwaySlugs.map(p => ({
  name: p.role.split('&')[0].trim(),
  href: `/pathways/${p.slug}`
}));
---

<AppLayout title={title} description={description} breadcrumbs={[{ label: 'Jalur Belajar Peran' }]}>
  <div class="space-y-6">
    <!-- Section Sub-Navigation -->
    <SectionSubNav
      currentPath="/pathways"
      hubHref="/pathways"
      hubLabel="🧭 Semua Peran"
      items={subNavItems}
    />

    <!-- Header Strip -->
    <div class="space-y-2 pb-4 border-b border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-2">
        <span class="p-1.5 rounded-lg bg-indigo-100 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400">
          <Compass className="w-4 h-4" />
        </span>
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 font-mono">
          Executive Role Pathways
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
        Jalur Belajar Terarah per Peran C-Level
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
        Pilih peran kepemimpinan Anda di bawah untuk mendapatkan kurasi modul yang relevan dengan tanggung jawab Anda tanpa perlu mempelajari hal yang bukan porsi Anda.
      </p>
    </div>

    <!-- Pathways Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">
      {pathwaysData.map((pathway) => {
        const slugObj = pathwaySlugs.find(p => p.role === pathway.role);
        const slugUrl = `/pathways/${slugObj?.slug || 'ceo'}`;

        return (
          <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm hover:border-indigo-500/60 dark:hover:border-indigo-500/60 transition-all flex flex-col justify-between space-y-5 group">
            <div class="space-y-4">
              <!-- Top Metadata -->
              <div class="flex items-center justify-between gap-2">
                <span class="text-2xl">{pathway.icon}</span>
                <span class="text-[11px] font-mono font-bold px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                  {pathway.recommendedModules.length} Modul Terkurasi
                </span>
              </div>

              <!-- Title & Summary -->
              <div>
                <h2 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                  {pathway.role}
                </h2>
                <div class="text-xs font-semibold text-slate-500 dark:text-slate-400 mt-0.5">
                  {pathway.title}
                </div>
              </div>

              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                {pathway.summary}
              </p>

              <!-- Modules Preview -->
              <div class="space-y-1.5 pt-2 border-t border-slate-100 dark:border-slate-800">
                <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                  Fokus Pembahasan:
                </div>
                <div class="space-y-1">
                  {pathway.recommendedModules.slice(0, 3).map((mod) => (
                    <div class="flex items-center gap-2 text-xs text-slate-700 dark:text-slate-300">
                      <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 shrink-0"></span>
                      <span class="font-medium truncate">{mod.name}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <!-- Bottom Link -->
            <div class="pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
              <span class="text-xs text-slate-400 font-mono">
                {slugObj?.slug.toUpperCase()}
              </span>
              <a
                href={slugUrl}
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm transition-all group-hover:translate-x-0.5 cursor-pointer"
              >
                <span>Buka Jalur {pathway.role.split('&')[0].trim()}</span>
                <ArrowRight className="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</AppLayout>
