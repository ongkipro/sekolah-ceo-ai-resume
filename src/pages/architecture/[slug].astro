---
import AppLayout from '../../layouts/AppLayout.astro';
import SectionSubNav from '../../components/SectionSubNav.astro';
import diagramsData from '../../data/diagrams.json';
import { architectureSlugs } from '../../lib/slugs';
import { Layers, ArrowRight, ArrowLeft, CheckCircle2, Cpu } from 'lucide-react';

export async function getStaticPaths() {
  return architectureSlugs.map(({ slug, id }) => {
    const diagram = diagramsData.find((d) => d.id === id);
    return {
      params: { slug },
      props: { diagram, slug },
    };
  });
}

const { diagram, slug } = Astro.props;
const currentIndex = architectureSlugs.findIndex((d) => d.slug === slug);
const prevDiagram = currentIndex > 0 ? diagramsData[currentIndex - 1] : null;
const nextDiagram = currentIndex < diagramsData.length - 1 ? diagramsData[currentIndex + 1] : null;

const title = `${diagram.title} - Visual Architecture Blueprint`;
const description = diagram.subtitle;

const breadcrumbs = [
  { label: 'Arsitektur Sistem', href: '/architecture' },
  { label: diagram.title.split('(')[0].trim().replace('The ', '') }
];

const subNavItems = architectureSlugs.map(a => ({
  name: a.name,
  href: `/architecture/${a.slug}`
}));
---

<AppLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <div class="space-y-6 max-w-full">
    <!-- Section Sub-Navigation -->
    <SectionSubNav
      currentPath={`/architecture/${diagram.slug}`}
      hubHref="/architecture"
      hubLabel="Semua Blueprint"
      items={subNavItems}
    />

    <!-- Header Blueprint Card -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl sm:rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 pb-5 border-b border-slate-100 dark:border-slate-800">
        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <span class="p-1.5 rounded-lg bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400">
              <Layers className="w-4 h-4" />
            </span>
            <span class="text-xs font-mono font-bold uppercase tracking-wider px-2.5 py-1 rounded-lg bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-900">
              Arsitektur Bisnis AI
            </span>
            <span class="text-xs text-slate-400">• Arsitek: {diagram.speaker}</span>
          </div>
          <h1 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white leading-snug">
            {diagram.title}
          </h1>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed font-medium">
            {diagram.subtitle}
          </p>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 text-xs font-mono text-slate-500 dark:text-slate-400 shrink-0">
          <div>Rangkaian:</div>
          <div class="font-bold text-slate-900 dark:text-white">{(diagram.nodes?.length || 0)} Tahap Terintegrasi</div>
        </div>
      </div>

      <!-- Step-by-Step Flow Nodes -->
      <div class="space-y-4">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
          <Cpu className="w-4 h-4 text-blue-500" />
          <span>Alur Eksekusi Langkah demi Langkah:</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-5 gap-4 relative">
          {(diagram.nodes || []).map((node: any) => (
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/60 flex flex-col justify-between space-y-4 shadow-sm hover:border-blue-500/60 transition-all group">
              <div class="space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class="w-7 h-7 rounded-xl bg-blue-100 dark:bg-blue-900/80 text-blue-700 dark:text-blue-300 font-bold text-xs flex items-center justify-center font-mono">
                    0{node.step}
                  </span>
                  <span class="text-2xl">{node.icon}</span>
                </div>
                <h3 class="text-sm font-bold text-slate-900 dark:text-white leading-snug">
                  {node.title}
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                  {node.description}
                </p>
              </div>

              <div class="pt-3 border-t border-slate-200/60 dark:border-slate-700/60">
                <span class="text-[10px] font-mono px-2 py-1 rounded-md bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-blue-600 dark:text-blue-400 font-bold block truncate text-center">
                  {node.tool}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
      )}
    </div>

    <!-- Navigation to Previous / Next Blueprint -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-2">
      {prevDiagram ? (
        <a
          href={`/architecture/${prevDiagram.slug}`}
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors w-full sm:w-auto justify-center cursor-pointer"
        >
          <ArrowLeft className="w-4 h-4" />
          <span>Blueprint Sebelumnya</span>
        </a>
      ) : <div />}

      {nextDiagram ? (
        <a
          href={`/architecture/${nextDiagram.slug}`}
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold transition-all shadow-sm w-full sm:w-auto justify-center cursor-pointer"
        >
          <span>Blueprint Berikutnya</span>
          <ArrowRight className="w-4 h-4" />
        </a>
      ) : <div />}
    </div>
  </div>
</AppLayout>
