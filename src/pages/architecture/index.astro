---
import AppLayout from '../../layouts/AppLayout.astro';
import SectionSubNav from '../../components/SectionSubNav.astro';
import diagramsData from '../../data/diagrams.json';
import { architectureSlugs } from '../../lib/slugs';
import { Layers, ArrowRight, Sparkles } from 'lucide-react';

const title = "Visual Architecture Blueprints - Sekolah CEO AI (Agustus 2026)";
const description = "4 diagram alur arsitektur bisnis AI: 0-CAC Growth Funnel, Koran Perusahaan 07.00 Pagi, Local Desktop Command Center, dan Auto-PO Supply Chain.";

const subNavItems = architectureSlugs.map(a => ({
  name: a.name,
  href: `/architecture/${a.slug}`
}));
---

<AppLayout title={title} description={description} breadcrumbs={[{ label: 'Arsitektur Sistem' }]}>
  <div class="space-y-6">
    <!-- Section Sub-Navigation -->
    <SectionSubNav
      currentPath="/architecture"
      hubHref="/architecture"
      hubLabel="Semua Blueprint"
      items={subNavItems}
    />

    <!-- Header Strip -->
    <div class="space-y-2 pb-4 border-b border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-2">
        <span class="p-1.5 rounded-lg bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400">
          <Layers className="w-4 h-4" />
        </span>
        <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 font-mono">
          Architecture Blueprints
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
        4 Alur Kerja Arsitektur Bisnis AI
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
        Pilih blueprint di bawah untuk mempelajari diagram alur langkah demi langkah, integrasi tools yang dibutuhkan, dan cara kerja operasionalnya di perusahaan.
      </p>
    </div>

    <!-- Blueprints Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">
      {diagramsData.map((d) => {
        const slugObj = architectureSlugs.find(s => s.id === d.id); const slugUrl = `/architecture/${slugObj?.slug || d.id}`;

        return (
          <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm hover:border-blue-500/60 dark:hover:border-blue-500/60 transition-all flex flex-col justify-between space-y-5 group">
            <div class="space-y-4">
              <!-- Top Metadata -->
              <div class="flex items-center justify-between gap-2">
                <span class="text-[11px] font-mono font-bold uppercase tracking-wider px-2.5 py-1 rounded-lg bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-300 border border-blue-100 dark:border-blue-900">
                  {(d.nodes?.length || 0)} Langkah Alur
                </span>
                <span class="text-xs text-slate-400 font-medium">Arsitek: {d.speaker}</span>
              </div>

              <!-- Title & Subtitle -->
              <div>
                <h2 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                  {d.title}
                </h2>
                <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mt-1.5">
                  {d.subtitle}
                </p>
              </div>

              <!-- Steps List Preview -->
              <div class="space-y-1.5 pt-2 border-t border-slate-100 dark:border-slate-800">
                <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                  Rangkaian Node:
                </div>
                <div class="flex flex-wrap gap-1.5">
                  {(d.nodes || []).map((node: any) => (
                    <span class="inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
                      <span>{node.icon}</span>
                      <span class="truncate max-w-[150px]">{node.title}</span>
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Bottom Link -->
            <div class="pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
              <span class="text-xs text-slate-400 font-mono">
                { (slugObj?.slug || d.id).toUpperCase() }
              </span>
              <a
                href={slugUrl}
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white shadow-sm transition-all group-hover:translate-x-0.5 cursor-pointer"
              >
                <span>Buka Blueprint Penuh</span>
                <ArrowRight className="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</AppLayout>
