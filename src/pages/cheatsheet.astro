---
import AppLayout from '../layouts/AppLayout.astro';
import ExecutiveCheatsheet from '../components/ExecutiveCheatsheet';
import { Zap, ArrowLeft } from 'lucide-react';
---

<AppLayout title="Contekkan 3 Menit Eksekutif - Sekolah CEO AI">
  <!-- Page Header -->
  <div class="space-y-2 pb-6 border-b border-slate-200 dark:border-slate-800">
    <div class="flex items-center gap-2">
      <a href="/" class="text-xs font-semibold text-slate-400 hover:text-blue-600 flex items-center gap-1">
        <ArrowLeft className="w-3.5 h-3.5" /> Dashboard
      </a>
      <span class="text-slate-300 dark:text-slate-700">/</span>
      <span class="text-xs font-semibold text-amber-600 dark:text-amber-400">Modul Cepat</span>
    </div>
    <div class="flex items-center gap-2.5">
      <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-900/60 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold">
        <Zap className="w-5 h-5" />
      </div>
      <div>
        <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          Contekkan 3 Menit Eksekutif (Executive Cheatsheet)
        </h1>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Ringkasan kilat per sesi untuk C-Level yang super sibuk: apa yang harus dilakukan besok, 1 kesalahan fatal yang harus dihindari, 3 angka kunci, dan 1 master prompt.
        </p>
      </div>
    </div>
  </div>

  <!-- Interactive Cheatsheet Island -->
  <ExecutiveCheatsheet client:load />
</AppLayout>
