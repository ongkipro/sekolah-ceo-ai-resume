---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SidebarNav from '../components/SidebarNav.astro';
import { 
  LayoutDashboard, 
  Video, 
  BookMarked, 
  Layers, 
  FileText, 
  Calculator, 
  Wrench, 
  Target, 
  HelpCircle,
  Zap,
  Compass,
  Award,
  Sparkles,
  X,
  Menu,
  ChevronRight
} from 'lucide-react';
import { 
  sessionSlugs, 
  pathwaySlugs, 
  architectureSlugs, 
  simulatorSlugs, 
  promptSlugs 
} from '../lib/slugs';

interface Props {
  title?: string;
  description?: string;
  breadcrumbs?: Array<{ label: string; href?: string }>;
}

const {
  title = "Sekolah CEO AI Hub - Executive Knowledge Base",
  description = "Panduan operasional dan resume lengkap masterclass Sekolah CEO AI bersama Mas Anjas Maradita, Mas Satya Pradana, dan Pak Natali Ardianto.",
  breadcrumbs,
} = Astro.props;

const pathname = Astro.url.pathname;

const mobileMenuSections = [
  {
    group: 'Akselerator Belajar',
    items: [
      { name: 'Dashboard', href: '/', icon: LayoutDashboard, badge: 'Home' },
      { name: 'Contekkan 3 Menit', href: '/cheatsheet', icon: Zap, badge: 'Ringkas' },
      { name: 'Jalur Belajar Peran', href: '/pathways', icon: Compass, badge: '4 Peran' },
      { name: 'Tes Kematangan AI', href: '/quiz', icon: Award, badge: 'Kuis' },
    ]
  },
  {
    group: 'Kurikulum & Materi',
    items: [
      { name: 'Kurikulum Masterclass', href: '/curriculum', icon: Video, badge: '4 Sesi' },
      { name: 'Kamus Istilah Awam', href: '/glossary', icon: BookMarked, badge: 'A-Z' },
      { name: 'Arsitektur Sistem', href: '/architecture', icon: Layers, badge: '4 Alur' },
    ]
  },
  {
    group: 'Tools & Eksekusi',
    items: [
      { name: 'Prompt Vault', href: '/prompts', icon: FileText, badge: '8 Prompt' },
      { name: 'CEO Simulator', href: '/simulator', icon: Calculator, badge: 'ROI Calc' },
      { name: 'AI Tools Directory', href: '/tools', icon: Wrench, badge: '8 Tools' },
      { name: '30-60-90 Roadmap', href: '/roadmap', icon: Target, badge: 'Aksi' },
      { name: 'Executive FAQ', href: '/faq', icon: HelpCircle, badge: 'Q&A' },
    ]
  }
];

const bottomNavItems = [
  { name: 'Home', href: '/', icon: LayoutDashboard },
  { name: 'Kurikulum', href: '/curriculum', icon: Video },
  { name: 'Contekkan', href: '/cheatsheet', icon: Zap },
  { name: 'Prompt', href: '/prompts', icon: FileText },
];
---

<!doctype html>
<html lang="id" class="overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Google Fonts: Inter & JetBrains Mono with display=swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Theme Script (Defaults to Light) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="min-h-screen overflow-x-hidden max-w-full flex flex-col bg-slate-50 dark:bg-[#090d16] text-slate-900 dark:text-slate-100 transition-colors selection:bg-blue-600 selection:text-white font-sans antialiased">
    <!-- Top Global Header -->
    <Header />

    <!-- Main Shell with Sidebar -->
    <div class="flex-1 flex max-w-7xl w-full mx-auto">
      <!-- Desktop Sidebar -->
      <SidebarNav />

      <!-- Page Content Area -->
      <main class="flex-1 min-w-0 p-4 sm:p-6 lg:p-8 space-y-6 pb-28 lg:pb-12 max-w-full">
        <!-- Interactive Clickable Breadcrumbs -->
        {breadcrumbs && breadcrumbs.length > 0 && (
          <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 overflow-x-auto no-scrollbar pb-1">
            <a href="/" class="hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer shrink-0 font-medium">
              Home
            </a>
            {breadcrumbs.map((b, i) => {
              const isLast = i === breadcrumbs.length - 1;
              return (
                <span class="flex items-center gap-1.5 shrink-0">
                  <ChevronRight className="w-3.5 h-3.5 text-slate-400" />
                  {b.href && !isLast ? (
                    <a href={b.href} class="hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer font-medium underline-offset-2 hover:underline">
                      {b.label}
                    </a>
                  ) : (
                    <span class="font-bold text-slate-900 dark:text-white">{b.label}</span>
                  )}
                </span>
              );
            })}
          </nav>
        )}
        <slot />
      </main>
    </div>

    <!-- Minimalist Clean Footer -->
    <Footer />

    <!-- Mobile Slide-Over Navigation Drawer -->
    <div
      id="mobile-drawer-root"
      class="fixed inset-0 z-50 hidden transition-opacity duration-200"
      aria-hidden="true"
    >
      <!-- Backdrop -->
      <div
        id="drawer-backdrop"
        class="absolute inset-0 bg-slate-950/50 backdrop-blur-sm cursor-pointer"
      ></div>

      <!-- Slide-Over Panel -->
      <div
        id="drawer-panel"
        class="absolute inset-y-0 left-0 w-4/5 max-w-xs bg-white dark:bg-[#090d16] border-r border-slate-200 dark:border-slate-800 shadow-2xl flex flex-col pointer-events-auto transform -translate-x-full transition-transform duration-200 ease-out z-10"
      >
        <!-- Drawer Header -->
        <div class="p-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
          <a href="/" class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-slate-900 dark:bg-white text-white dark:text-slate-900 flex items-center justify-center font-bold text-xs">
              CEO
            </div>
            <div>
              <div class="font-bold text-xs text-slate-900 dark:text-white">Sekolah CEO AI</div>
              <div class="text-[10px] text-slate-500 dark:text-slate-400 font-mono">Executive Hub 2026</div>
            </div>
          </a>

          <button
            id="drawer-close-btn"
            type="button"
            class="p-1.5 rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
            aria-label="Tutup Menu"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        <!-- Drawer Nav Items -->
        <div class="flex-1 overflow-y-auto p-3 space-y-4">
          {mobileMenuSections.map((group) => (
            <div class="space-y-1">
              <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 px-3 py-1">
                {group.group}
              </div>
              <div class="space-y-0.5">
                {group.items.map((item) => {
                  const Icon = item.icon;
                  const isActive = item.href === '/' 
                    ? pathname === '/' 
                    : pathname.startsWith(item.href);
                  return (
                    <a
                      href={item.href}
                      class={`flex items-center justify-between px-3 py-2.5 rounded-xl text-xs font-medium transition-all cursor-pointer ${
                        isActive
                          ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-bold shadow-2xs'
                          : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60'
                      }`}
                    >
                      <div class="flex items-center gap-2.5">
                        <Icon className={`w-4 h-4 ${isActive ? 'text-blue-400 dark:text-blue-600' : 'text-slate-400'}`} />
                        <span>{item.name}</span>
                      </div>
                      <span class={`text-[10px] font-mono px-1.5 py-0.5 rounded ${
                        isActive 
                          ? 'bg-white/20 dark:bg-slate-900/20 text-white dark:text-slate-900 font-bold' 
                          : 'bg-slate-100 dark:bg-slate-800 text-slate-500'
                      }`}>
                        {item.badge}
                      </span>
                    </a>
                  );
                })}
              </div>
            </div>
          ))}
        </div>

        <!-- Drawer Footer -->
        <div class="p-3 border-t border-slate-200 dark:border-slate-800 text-center text-xs text-slate-500 dark:text-slate-400">
          Sekolah CEO AI • Agustus 2026
        </div>
      </div>
    </div>

    <!-- Mobile Bottom Navigation Bar (Minimalist) -->
    <nav class="lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 dark:bg-[#090d16]/95 backdrop-blur-md border-t border-slate-200 dark:border-slate-800 px-3 py-1.5 pb-[calc(0.375rem+env(safe-area-inset-bottom))]">
      <div class="flex items-center justify-around max-w-md mx-auto">
        {bottomNavItems.map((item) => {
          const Icon = item.icon;
          const isActive = item.href === '/' 
            ? pathname === '/' 
            : pathname.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={`flex flex-col items-center gap-0.5 py-1 px-3 rounded-lg text-[10px] font-medium transition-colors cursor-pointer ${
                isActive
                  ? 'text-blue-600 dark:text-blue-400 font-bold'
                  : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'
              }`}
            >
              <Icon className="w-4 h-4" />
              <span>{item.name}</span>
            </a>
          );
        })}

        <!-- 5th Item: Menu Drawer Trigger -->
        <button
          type="button"
          class="drawer-open-btn flex flex-col items-center gap-0.5 py-1 px-3 rounded-lg text-[10px] font-medium text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors cursor-pointer"
          aria-label="Buka Menu Lengkap"
        >
          <Menu className="w-4 h-4" />
          <span>Menu</span>
        </button>
      </div>
    </nav>

    <!-- Global Mobile Drawer Scripts -->
    <script is:inline>
      const drawerRoot = document.getElementById('mobile-drawer-root');
      const drawerPanel = document.getElementById('drawer-panel');
      const backdrop = document.getElementById('drawer-backdrop');
      const closeBtn = document.getElementById('drawer-close-btn');
      const openBtns = document.querySelectorAll('.drawer-open-btn');

      function openDrawer() {
        if (!drawerRoot || !drawerPanel) return;
        drawerRoot.classList.remove('hidden');
        // trigger animation on next tick
        requestAnimationFrame(() => {
          drawerPanel.classList.remove('-translate-x-full');
          drawerPanel.classList.add('translate-x-0');
        });
        document.body.style.overflow = 'hidden';
      }

      function closeDrawer() {
        if (!drawerRoot || !drawerPanel) return;
        drawerPanel.classList.remove('translate-x-0');
        drawerPanel.classList.add('-translate-x-full');
        setTimeout(() => {
          drawerRoot.classList.add('hidden');
          document.body.style.overflow = '';
        }, 200);
      }

      openBtns.forEach((btn) => btn.addEventListener('click', openDrawer));
      if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
      if (backdrop) backdrop.addEventListener('click', closeDrawer);

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeDrawer();
      });
    </script>
  </body>
</html>
