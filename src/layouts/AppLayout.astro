---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SidebarNav from '../components/SidebarNav.astro';
import { 
  LayoutDashboard, 
  Video, 
  Zap,
  FileText, 
  Menu
} from 'lucide-react';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Sekolah CEO AI Hub - Executive Knowledge Base",
  description = "Panduan operasional dan resume lengkap masterclass Sekolah CEO AI bersama Mas Anjas Maradita, Mas Satya Pradana, dan Pak Natali Ardianto.",
} = Astro.props;

const pathname = Astro.url.pathname;
const bottomNavItems = [
  { name: 'Home', href: '/', icon: LayoutDashboard },
  { name: 'Video', href: '/curriculum', icon: Video },
  { name: 'Contekkan', href: '/cheatsheet', icon: Zap },
  { name: 'Prompt', href: '/prompts', icon: FileText },
];
---

<!doctype html>
<html lang="id" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet" />

    <!-- Theme Script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'dark';
      })();

      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 dark:bg-[#090d16] text-slate-900 dark:text-slate-100 transition-colors selection:bg-blue-600 selection:text-white">
    <!-- Top Global Header -->
    <Header />

    <!-- Main Shell with Sidebar -->
    <div class="flex-1 flex max-w-7xl w-full mx-auto">
      <!-- Desktop Sidebar -->
      <SidebarNav />

      <!-- Page Content Area with Mobile Safe Bottom Padding -->
      <main class="flex-1 min-w-0 p-3.5 sm:p-6 lg:p-8 space-y-8 pb-28 lg:pb-12">
        <slot />
      </main>
    </div>

    <!-- Mobile Bottom Navigation Bar (5 Items with Menu Drawer Trigger) -->
    <div class="lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-t border-slate-200 dark:border-slate-800 px-3 py-2 flex items-center justify-between shadow-lg">
      {bottomNavItems.map((m) => {
        const Icon = m.icon;
        const active = m.href === '/' ? pathname === '/' : pathname.startsWith(m.href);
        return (
          <a
            href={m.href}
            class={`flex flex-col items-center py-1 px-2.5 rounded-xl text-[10px] font-medium transition-all ${
              active
                ? 'text-blue-600 dark:text-blue-400 font-bold scale-105'
                : 'text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200'
            }`}
          >
            <Icon className="w-4 h-4 mb-0.5" />
            <span>{m.name}</span>
          </a>
        );
      })}

      <!-- Open All Menu Button -->
      <button
        id="mobile-all-menu-btn"
        class="flex flex-col items-center py-1 px-2.5 rounded-xl text-[10px] font-medium text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
      >
        <Menu className="w-4 h-4 mb-0.5" />
        <span>Menu</span>
      </button>
    </div>

    <!-- Footer -->
    <Footer />

    <script is:inline>
      const menuBtn = document.getElementById('mobile-all-menu-btn');
      if (menuBtn) {
        menuBtn.addEventListener('click', () => {
          window.dispatchEvent(new CustomEvent('openMobileDrawer'));
        });
      }
    </script>
  </body>
</html>
