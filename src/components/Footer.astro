---
import { Sparkles, Shield, Heart } from 'lucide-react';
---

<footer class="w-full bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 py-8 px-4 sm:px-6 lg:px-8 transition-colors">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
    <!-- Brand & Copyright -->
    <div class="flex items-center gap-2">
      <div class="w-6 h-6 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-xs">
        <Sparkles className="w-3.5 h-3.5 text-amber-300" />
      </div>
      <div>
        <span class="font-bold text-slate-900 dark:text-white">Sekolah CEO AI (Agustus 2026)</span>
        <span class="text-slate-400 dark:text-slate-500"> • Executive Knowledge Base</span>
      </div>
    </div>

    <!-- Middle Note -->
    <div class="text-center text-[11px] text-slate-400 dark:text-slate-500">
      Disusun khusus untuk akselerasi eksekutif bisnis non-teknis & efisiensi operasional 90%.
    </div>

    <!-- Right Badge -->
    <div class="flex items-center gap-3 text-[11px] font-mono">
      <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
        v1.4 Production
      </span>
    </div>
  </div>
</footer>
