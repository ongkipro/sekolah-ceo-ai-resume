---
import { Play, Sparkles, TrendingDown, Clock, Users, ArrowRight, ShieldCheck, Zap, BookMarked, HelpCircle } from 'lucide-react';
---

<section class="relative w-full pt-8 pb-12 overflow-hidden">
  <!-- Subtle Background Glow -->
  <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-3/4 h-80 bg-gradient-to-r from-blue-500/10 via-indigo-500/10 to-purple-500/10 blur-3xl rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
    <!-- Top Announcement Badge -->
    <div class="flex items-center justify-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800 text-xs font-semibold text-blue-700 dark:text-blue-300 shadow-sm">
        <Sparkles className="w-3.5 h-3.5 text-amber-400" />
        <span>Executive Masterclass Resume & Playbook (Edisi Bahasa Awam & C-Level)</span>
      </div>
    </div>

    <!-- Main Hero Heading -->
    <div class="text-center max-w-4xl mx-auto space-y-4">
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        Sistem Operasi Bisnis Eksekutif <br />
        <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent">
          Berbasis Artificial Intelligence
        </span>
      </h1>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Bedah tuntas kurikulum 2 hari (~12+ jam) <strong>Sekolah CEO AI (Agustus 2026)</strong>. Dilengkapi penjelasan analogi bahasa awam agar semua konsep, rumus prompt, dan alur otomatisasi langsung dipahami pemilik bisnis non-teknis.
      </p>
    </div>

    <!-- Quick Action Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href="#curriculum"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-bold text-sm bg-blue-600 hover:bg-blue-700 text-white shadow-md shadow-blue-600/20 transition-all hover:scale-[1.02]"
      >
        <Play className="w-4 h-4 fill-current" />
        Jelajahi Sesi Video & Timestamp
      </a>
      <a
        href="#glossary"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-bold text-sm bg-emerald-50 dark:bg-emerald-950/60 hover:bg-emerald-100 border border-emerald-300 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 transition-all"
      >
        <BookMarked className="w-4 h-4 text-emerald-600 dark:text-emerald-400" />
        Kamus Istilah Awam
      </a>
      <a
        href="#prompts"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-bold text-sm bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white shadow-sm transition-all"
      >
        <Zap className="w-4 h-4 text-amber-500" />
        Buka Prompt Vault
      </a>
      <a
        href="#faq"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-bold text-sm bg-slate-100 dark:bg-slate-800/60 hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition-all"
      >
        <HelpCircle className="w-4 h-4 text-blue-500" />
        Executive FAQ
      </a>
    </div>

    <!-- Bento Grid Stats & Key Highlights -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 pt-4">
      <!-- Bento 1 -->
      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-2 hover:border-blue-500/50 transition-colors">
        <div class="w-9 h-9 rounded-xl bg-blue-50 dark:bg-blue-950 flex items-center justify-center text-blue-600 dark:text-blue-400">
          <Clock className="w-5 h-5" />
        </div>
        <div class="text-2xl font-black text-slate-900 dark:text-white">12+ Jam</div>
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400">4 Sesi Lengkap</div>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Transkrip verbatim dan video YouTube tersinkronisasi per detik topik materi.
        </p>
      </div>

      <!-- Bento 2 -->
      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-2 hover:border-indigo-500/50 transition-colors">
        <div class="w-9 h-9 rounded-xl bg-indigo-50 dark:bg-indigo-950 flex items-center justify-center text-indigo-600 dark:text-indigo-400">
          <Users className="w-5 h-5" />
        </div>
        <div class="text-2xl font-black text-slate-900 dark:text-white">3 Pakar Industri</div>
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Anjas, Satya, Natali</div>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Kombinasi founder unicorn, arsitek operasional/CFO, dan pioneer AI creative.
        </p>
      </div>

      <!-- Bento 3 -->
      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-2 hover:border-emerald-500/50 transition-colors">
        <div class="w-9 h-9 rounded-xl bg-emerald-50 dark:bg-emerald-950 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
          <TrendingDown className="w-5 h-5" />
        </div>
        <div class="text-2xl font-black text-slate-900 dark:text-white">90% Cost Cut</div>
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Anti-Fake Work</div>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Mengikis Parkinson&apos;s Law dan mengalihkan tugas kognitif repetitif ke agen AI.
        </p>
      </div>

      <!-- Bento 4 -->
      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-2 hover:border-purple-500/50 transition-colors">
        <div class="w-9 h-9 rounded-xl bg-purple-50 dark:bg-purple-950 flex items-center justify-center text-purple-600 dark:text-purple-400">
          <ShieldCheck className="w-5 h-5" />
        </div>
        <div class="text-2xl font-black text-slate-900 dark:text-white">Bahasa Awam</div>
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Analogi & FAQ</div>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Kamus istilah lengkap dan tanya jawab mitigasi risiko untuk pemilik bisnis.
        </p>
      </div>
    </div>
  </div>
</section>
