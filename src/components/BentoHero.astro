---
import { Play, Sparkles, TrendingDown, Clock, Users, ArrowRight, ShieldCheck, Zap, BookMarked, HelpCircle, Compass } from 'lucide-react';
---

<section class="relative w-full max-w-full pt-3 sm:pt-6 pb-6 overflow-hidden">
  <!-- Subtle Background Glow -->
  <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-3/4 h-72 bg-gradient-to-r from-blue-500/15 via-indigo-500/10 to-purple-500/15 blur-3xl rounded-full pointer-events-none"></div>

  <div class="space-y-5 sm:space-y-8 relative z-10 max-w-full">
    <!-- Top Announcement Badge -->
    <div class="flex items-center justify-center max-w-full px-2">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/80 text-[11px] sm:text-xs font-semibold text-blue-700 dark:text-blue-300 shadow-sm max-w-full">
        <Sparkles className="w-3.5 h-3.5 text-amber-400 shrink-0" />
        <span class="truncate">Executive Masterclass Playbook (Edisi Awam & C-Level)</span>
      </div>
    </div>

    <!-- Main Hero Heading -->
    <div class="text-center max-w-4xl mx-auto space-y-2.5 sm:space-y-4 px-2">
      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        Sistem Operasi Bisnis Eksekutif <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 dark:from-blue-400 dark:via-indigo-300 dark:to-purple-400 bg-clip-text text-transparent">
          Berbasis Artificial Intelligence
        </span>
      </h1>
      <p class="text-xs sm:text-sm lg:text-base text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Bedah tuntas kurikulum 2 hari (~12+ jam) <strong>Sekolah CEO AI (Agustus 2026)</strong>. Dilengkapi penjelasan analogi bahasa awam agar semua konsep, rumus prompt, dan alur otomatisasi langsung dipahami pemilik bisnis non-teknis.
      </p>
    </div>

    <!-- Quick Action Navigation Pills (Wrap cleanly on mobile) -->
    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 px-2">
      <a
        href="/curriculum"
        class="inline-flex items-center gap-1.5 sm:gap-2 px-3.5 sm:px-5 py-2.5 sm:py-3 rounded-xl font-bold text-xs sm:text-sm bg-blue-600 hover:bg-blue-700 text-white shadow-md shadow-blue-600/20 transition-all hover:scale-[1.02] active:scale-95 shrink-0"
      >
        <Play className="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current" />
        Kurikulum Video
      </a>
      <a
        href="/cheatsheet"
        class="inline-flex items-center gap-1.5 sm:gap-2 px-3.5 sm:px-5 py-2.5 sm:py-3 rounded-xl font-bold text-xs sm:text-sm bg-amber-50 dark:bg-amber-950/60 hover:bg-amber-100 dark:hover:bg-amber-900/60 border border-amber-300 dark:border-amber-800 text-amber-800 dark:text-amber-200 transition-all active:scale-95 shrink-0"
      >
        <Zap className="w-3.5 h-3.5 sm:w-4 sm:h-4 text-amber-500" />
        Contekkan 3 Menit
      </a>
      <a
        href="/pathways"
        class="inline-flex items-center gap-1.5 sm:gap-2 px-3.5 sm:px-5 py-2.5 sm:py-3 rounded-xl font-bold text-xs sm:text-sm bg-indigo-50 dark:bg-indigo-950/60 hover:bg-indigo-100 dark:hover:bg-indigo-900/60 border border-indigo-300 dark:border-indigo-800 text-indigo-800 dark:text-indigo-200 transition-all active:scale-95 shrink-0"
      >
        <Compass className="w-3.5 h-3.5 sm:w-4 sm:h-4 text-indigo-500" />
        Jalur Peran
      </a>
      <a
        href="/glossary"
        class="inline-flex items-center gap-1.5 sm:gap-2 px-3.5 sm:px-5 py-2.5 sm:py-3 rounded-xl font-bold text-xs sm:text-sm bg-emerald-50 dark:bg-emerald-950/60 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 border border-emerald-300 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 transition-all active:scale-95 shrink-0"
      >
        <BookMarked className="w-3.5 h-3.5 sm:w-4 sm:h-4 text-emerald-600 dark:text-emerald-400" />
        Kamus Awam
      </a>
    </div>

    <!-- Bento Grid Stats (Safe 2-col on small screens, 4-col on desktop) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-4 pt-2">
      <!-- Bento 1 -->
      <div class="p-3.5 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-1 sm:space-y-2 hover:border-blue-500/50 transition-colors min-w-0">
        <div class="w-7 h-7 sm:w-9 sm:h-9 rounded-xl bg-blue-50 dark:bg-blue-950 flex items-center justify-center text-blue-600 dark:text-blue-400">
          <Clock className="w-4 h-4 sm:w-5 sm:h-5" />
        </div>
        <div class="text-base sm:text-2xl font-black text-slate-900 dark:text-white">12+ Jam</div>
        <div class="text-[9px] sm:text-xs font-bold uppercase tracking-wider text-slate-400">4 Sesi Lengkap</div>
        <p class="text-[10px] sm:text-xs text-slate-500 dark:text-slate-400 line-clamp-2">
          Video YouTube tersinkronisasi per detik topik.
        </p>
      </div>

      <!-- Bento 2 -->
      <div class="p-3.5 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-1 sm:space-y-2 hover:border-indigo-500/50 transition-colors min-w-0">
        <div class="w-7 h-7 sm:w-9 sm:h-9 rounded-xl bg-indigo-50 dark:bg-indigo-950 flex items-center justify-center text-indigo-600 dark:text-indigo-400">
          <Users className="w-4 h-4 sm:w-5 sm:h-5" />
        </div>
        <div class="text-base sm:text-2xl font-black text-slate-900 dark:text-white">3 Pakar</div>
        <div class="text-[9px] sm:text-xs font-bold uppercase tracking-wider text-slate-400">Anjas, Satya, Natali</div>
        <p class="text-[10px] sm:text-xs text-slate-500 dark:text-slate-400 line-clamp-2">
          Founder unicorn, CFO/Ops, & pioneer AI.
        </p>
      </div>

      <!-- Bento 3 -->
      <div class="p-3.5 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-1 sm:space-y-2 hover:border-emerald-500/50 transition-colors min-w-0">
        <div class="w-7 h-7 sm:w-9 sm:h-9 rounded-xl bg-emerald-50 dark:bg-emerald-950 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
          <TrendingDown className="w-4 h-4 sm:w-5 sm:h-5" />
        </div>
        <div class="text-base sm:text-2xl font-black text-slate-900 dark:text-white">90% Cut</div>
        <div class="text-[9px] sm:text-xs font-bold uppercase tracking-wider text-slate-400">Anti-Fake Work</div>
        <p class="text-[10px] sm:text-xs text-slate-500 dark:text-slate-400 line-clamp-2">
          Alihkan tugas repetitif ke AI Agents.
        </p>
      </div>

      <!-- Bento 4 -->
      <div class="p-3.5 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-1 sm:space-y-2 hover:border-purple-500/50 transition-colors min-w-0">
        <div class="w-7 h-7 sm:w-9 sm:h-9 rounded-xl bg-purple-50 dark:bg-purple-950 flex items-center justify-center text-purple-600 dark:text-purple-400">
          <ShieldCheck className="w-4 h-4 sm:w-5 sm:h-5" />
        </div>
        <div class="text-base sm:text-2xl font-black text-slate-900 dark:text-white">Bahasa Awam</div>
        <div class="text-[9px] sm:text-xs font-bold uppercase tracking-wider text-slate-400">Analogi & FAQ</div>
        <p class="text-[10px] sm:text-xs text-slate-500 dark:text-slate-400 line-clamp-2">
          Kamus istilah & mitigasi risiko bisnis.
        </p>
      </div>
    </div>
  </div>
</section>
