---
import { Play, Sparkles, TrendingDown, Clock, Users, ArrowRight, ShieldCheck, Zap, BookMarked, Compass } from 'lucide-react';
---

<section class="relative w-full max-w-full pt-2 sm:pt-4 pb-6 overflow-hidden">
  <div class="space-y-6 sm:space-y-8 relative z-10 max-w-full">
    <!-- Top Announcement Badge -->
    <div class="flex items-center justify-center max-w-full">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-300 shadow-2xs">
        <Sparkles className="w-3.5 h-3.5 text-blue-600 dark:text-blue-400 shrink-0" />
        <span>Executive Masterclass Hub (Edisi Awam & C-Level)</span>
      </div>
    </div>

    <!-- Main Hero Heading (Clean & Minimalist, No Neon Slop) -->
    <div class="text-center max-w-3xl mx-auto space-y-3 px-2">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        Sistem Operasi Bisnis Eksekutif Berbasis Artificial Intelligence
      </h1>
      <p class="text-xs sm:text-sm lg:text-base text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Bedah tuntas kurikulum 2 hari (~12+ jam) <strong>Sekolah CEO AI (Agustus 2026)</strong>. Dilengkapi analogi bahasa orang awam agar semua konsep, rumus prompt, dan alur otomatisasi langsung dipahami pemilik bisnis non-teknis.
      </p>
    </div>

    <!-- Quick Action Navigation Pills (Minimalist) -->
    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-2.5 px-2">
      <a
        href="/curriculum"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl font-bold text-xs bg-slate-900 hover:bg-slate-800 text-white dark:bg-white dark:hover:bg-slate-100 dark:text-slate-900 shadow-sm transition-all active:scale-95 shrink-0"
      >
        <Play className="w-3.5 h-3.5 fill-current" />
        <span>Kurikulum Video</span>
      </a>
      <a
        href="/cheatsheet"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl font-bold text-xs bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200 transition-all active:scale-95 shrink-0 shadow-2xs"
      >
        <Zap className="w-3.5 h-3.5 text-amber-500" />
        <span>Contekkan 3 Menit</span>
      </a>
      <a
        href="/pathways"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl font-bold text-xs bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200 transition-all active:scale-95 shrink-0 shadow-2xs"
      >
        <Compass className="w-3.5 h-3.5 text-indigo-500" />
        <span>Jalur Peran</span>
      </a>
      <a
        href="/glossary"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl font-bold text-xs bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200 transition-all active:scale-95 shrink-0 shadow-2xs"
      >
        <BookMarked className="w-3.5 h-3.5 text-emerald-600" />
        <span>Kamus Awam</span>
      </a>
    </div>

    <!-- Bento Grid Stats (Minimalist Clean Surface) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 pt-2">
      <!-- Bento 1 -->
      <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xs space-y-1.5 min-w-0">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-400">Durasi</span>
          <Clock className="w-4 h-4 text-slate-400" />
        </div>
        <div class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white font-mono">12+ Jam</div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-2">
          4 Sesi video dengan sinkronisasi per detik.
        </p>
      </div>

      <!-- Bento 2 -->
      <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xs space-y-1.5 min-w-0">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-400">Instruktur</span>
          <Users className="w-4 h-4 text-slate-400" />
        </div>
        <div class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">3 Pakar</div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-2">
          Anjas Maradita, Satya Pradana, Natali Ardianto.
        </p>
      </div>

      <!-- Bento 3 -->
      <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xs space-y-1.5 min-w-0">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-400">Efisiensi</span>
          <TrendingDown className="w-4 h-4 text-slate-400" />
        </div>
        <div class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white font-mono">90% Cut</div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-2">
          Pangkas tugas repetitif dengan agen AI.
        </p>
      </div>

      <!-- Bento 4 -->
      <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xs space-y-1.5 min-w-0">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-400">Bahasa</span>
          <ShieldCheck className="w-4 h-4 text-slate-400" />
        </div>
        <div class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">Orang Awam</div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-2">
          Analogi analog dunia nyata & kamus istilah.
        </p>
      </div>
    </div>
  </div>
</section>
